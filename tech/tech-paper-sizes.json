  "meta": {
    "seo_title": "Kağıt Boyutları Piksel - Ücretsiz İndir (Excel/CSV/PDF)",
    "seo_description": "33 standart kağıt boyutunun mm, inç ve 72, 150, 300 PPI piksel boyutlarıyla ücretsiz indirin. Excel, CSV ve PDF formatlarında mevcut.",
    "title": "Kağıt Boyutları ve Piksel Boyutları Veri Seti",
    "description": "Bu veri seti, 33 yaygın kağıt boyutunun milimetre ve inç cinsinden fiziksel boyutları ile 72, 150 ve 300 PPI çözünürlükleri için piksel boyutlarını içeren kapsamlı ayrıntılar sunar.",
    "key_takeaways": [
      "A4, Letter ve Legal gibi 33 standart kağıt boyutuna erişin.",
      "Mm, inç ve farklı PPI'lardaki piksel boyutlarını keşfedin.",
      "Tasarım ve baskı projeleri için hassas piksel dönüşümlerini indirin.",
      "Her kağıt boyutu için yaygın kullanım açıklamalarını kullanın."
    ],
